{
  "name": "rede-back",
  "version": "0.1.0",
  "type": "module",
  "description": "API para plataforma de publicacao de dados sobre audiovisual e artes nos paises PALOP.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "keywords": [
    "fastify",
    "typescript",
    "palop",
    "audiovisual",
    "artes"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.3",
    "@fastify/sensible": "^6.0.2",
    "@supabase/supabase-js": "^2.110.8",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "google-auth-library": "^11.0.1",
    "mongodb": "^7.5.0",
    "nanoid": "^5.0.9",
    "resend": "^6.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@vercel/node": "^5.9.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
